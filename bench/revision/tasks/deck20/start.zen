      rect id="p17.panel" x=(px)616 y=(px)168 w=(px)296 h=(px)200 fill=(token)"color.soft" radius=(token)"radius.panel"
      text id="p17.stat" x=(px)640 y=(px)196 w=(px)248 h=(px)60 style="deck.stat" { span "$18M" }
