    token id="serif" type="fontFamily" value="Noto Serif"
    token id="sans" type="fontFamily" value="Noto Sans"
    token id="mono" type="fontFamily" value="Noto Sans Mono"
    token id="grad.sky" type="gradient" angle=(deg)90 {
      stop offset=0.0 color=(token)"color.dark-sky"
      stop offset=0.6 color=(token)"color.dusk"
      stop offset=1.0 color=(token)"color.horizon"
    }
    token id="grad.moon" type="gradient" angle=(deg)90 {
      stop offset=0.0 color=(token)"color.moonlight"
      stop offset=0.58 color=(token)"color.apricot"
      stop offset=1.0 color=(token)"color.rose"
    }
    token id="water" type="gradient" angle=(deg)90 {
      stop offset=0.0 color=(token)"color.lake-lit"
      stop offset=1.0 color=(token)"color.lake-dark"
    }
  }
  styles {
    style id="edition" {
      font-family (token)"mono"
      font-size (token)"px.13"
      font-weight (token)"weight.600"
      fill (token)"accent"
    }
    style id="details" {
      font-family (token)"sans"
      font-size (token)"px.18"
      font-weight (token)"weight.600"
      fill (token)"paper"
    }
  }
