zenith version=1 {
  project id="proj.night-garden" name="Night Garden"
  tokens format="zenith-token-v1" {
    token id="color.paper" type="color" value="#f2ede4"
    token id="color.ink" type="color" value="#141619"
    token id="color.muted" type="color" value="#52565e"
    token id="color.forest" type="color" value="#174d3c"
    token id="color.sage" type="color" value="#2d7a5f"
    token id="color.mist" type="color" value="#d9e4dd"
    token id="color.accent" type="color" value="#b5381c"
    token id="color.rule" type="color" value="#c8c1b4"
    token id="color.cream" type="color" value="#f7f4ee"
    token id="font.serif" type="fontFamily" value="Noto Serif"
    token id="font.sans" type="fontFamily" value="Noto Sans"
    token id="font.mono" type="fontFamily" value="Noto Sans Mono"
    token id="size.micro" type="dimension" value=(px)11
    token id="size.body" type="dimension" value=(px)13
    token id="size.sub" type="dimension" value=(px)16
    token id="size.title" type="dimension" value=(px)68
    token id="size.num" type="dimension" value=(px)22
    token id="stroke.thin" type="dimension" value=(px)1
    token id="stroke.med" type="dimension" value=(px)2
    token id="weight.400" type="fontWeight" value=400
    token id="weight.600" type="fontWeight" value=600
    token id="weight.700" type="fontWeight" value=700
  }
  styles {
    style id="eyebrow" {
      font-family (token)"font.mono"
      font-size (token)"size.micro"
      font-weight (token)"weight.600"
      fill (token)"color.muted"
    }
    style id="meta-label" {
      font-family (token)"font.mono"
      font-size (token)"size.micro"
      font-weight (token)"weight.600"
      fill (token)"color.accent"
    }
    style id="meta-value" {
      font-family (token)"font.sans"
      font-size (token)"size.body"
      font-weight (token)"weight.600"
      fill (token)"color.ink"
    }
    style id="meta-sub" {
      font-family (token)"font.sans"
      font-size (token)"size.body"
      font-weight (token)"weight.400"
      fill (token)"color.muted"
    }
  }
  document id="doc.night-garden" title="Night Garden" {
    page id="poster" w=(px)600 h=(px)720 background=(token)"color.paper" {
      // Top exhibition metadata strip
      text id="institution" x=(px)36 y=(px)28 w=(px)240 h=(px)18 style="eyebrow" { span "KUNSTHALLE BOTANICA" }
      text id="edition" x=(px)286 y=(px)28 w=(px)128 h=(px)18 style="eyebrow" { span "EXHIBITION 04" }
      text id="season" x=(px)424 y=(px)28 w=(px)140 h=(px)18 style="eyebrow" align="end" { span "AUTUMN 2026" }
      line id="rule.top" x1=(px)36 y1=(px)54 x2=(px)564 y2=(px)54 stroke=(token)"color.ink" stroke-width=(token)"stroke.med"

      // Display headline
      text id="headline" x=(px)35 y=(px)66 w=(px)530 h=(px)84 overflow="autofit" font-family=(token)"font.serif" font-size=(token)"size.title" font-weight=(token)"weight.700" fill=(token)"color.ink" { span "Night Garden" }
      text id="subtitle" x=(px)36 y=(px)154 w=(px)380 h=(px)24 font-family=(token)"font.sans" font-size=(token)"size.sub" font-weight=(token)"weight.400" fill=(token)"color.muted" { span "Nocturnal flora, glasshouse geometry & shadow" }
      text id="index-mark" x=(px)464 y=(px)150 w=(px)100 h=(px)28 align="end" font-family=(token)"font.mono" font-size=(token)"size.num" font-weight=(token)"weight.700" fill=(token)"color.accent" { span "No. 04" }

      // Architectural conservatory composition
      group id="artwork" {
        rect id="stage.bg" x=(px)36 y=(px)196 w=(px)528 h=(px)384 fill=(token)"color.ink"
        rect id="stage.panel" x=(px)36 y=(px)196 w=(px)264 h=(px)384 fill=(token)"color.forest"
        rect id="stage.inset" x=(px)300 y=(px)388 w=(px)264 h=(px)192 fill=(token)"color.mist"

        // Fine architectural grid lines over the lower-right light quadrant
        line id="grid.v1" x1=(px)366 y1=(px)388 x2=(px)366 y2=(px)580 stroke=(token)"color.forest" stroke-width=(token)"stroke.thin"
        line id="grid.v2" x1=(px)432 y1=(px)388 x2=(px)432 y2=(px)580 stroke=(token)"color.forest" stroke-width=(token)"stroke.thin"
        line id="grid.v3" x1=(px)498 y1=(px)388 x2=(px)498 y2=(px)580 stroke=(token)"color.forest" stroke-width=(token)"stroke.thin"
        line id="grid.h1" x1=(px)300 y1=(px)452 x2=(px)564 y2=(px)452 stroke=(token)"color.forest" stroke-width=(token)"stroke.thin"
        line id="grid.h2" x1=(px)300 y1=(px)516 x2=(px)564 y2=(px)516 stroke=(token)"color.forest" stroke-width=(token)"stroke.thin"
        ellipse id="node.seed" x=(px)420 y=(px)504 w=(px)24 h=(px)24 fill=(token)"color.ink"

        // Botanical geometric forms (lunar disc, conservatory rings, stem axis)
        ellipse id="orb.outer" x=(px)180 y=(px)228 w=(px)240 h=(px)240 fill=(token)"color.sage"
        ellipse id="orb.lunar" x=(px)236 y=(px)254 w=(px)188 h=(px)188 fill=(token)"color.cream"
        ellipse id="orb.core" x=(px)334 y=(px)286 w=(px)72 h=(px)72 fill=(token)"color.accent"

        // Architectural glasshouse mullions and botanical stem geometry
        rect id="arch.base" x=(px)88 y=(px)432 w=(px)160 h=(px)148 fill=(token)"color.ink"
        ellipse id="arch.dome" x=(px)88 y=(px)352 w=(px)160 h=(px)160 fill=(token)"color.ink"
        ellipse id="arch.inner" x=(px)116 y=(px)380 w=(px)104 h=(px)104 fill=(token)"color.forest"
        rect id="arch.pillar" x=(px)166 y=(px)380 w=(px)4 h=(px)200 fill=(token)"color.cream"

        // Caption inside artwork frame
        text id="plate-caption" x=(px)316 y=(px)214 w=(px)232 h=(px)18 align="end" font-family=(token)"font.mono" font-size=(token)"size.micro" font-weight=(token)"weight.600" fill=(token)"color.mist" { span "GLASS PAVILION · NORTH WING" }
      }

      // Swiss 3-column typographic footer
      line id="rule.foot" x1=(px)36 y1=(px)600 x2=(px)564 y2=(px)600 stroke=(token)"color.ink" stroke-width=(token)"stroke.thin"

      text id="col1.label" x=(px)36 y=(px)614 w=(px)164 h=(px)16 style="meta-label" { span "DATES" }
      text id="col1.val" x=(px)36 y=(px)634 w=(px)164 h=(px)20 style="meta-value" { span "14 Oct — 29 Nov" }
      text id="col1.sub" x=(px)36 y=(px)654 w=(px)164 h=(px)20 style="meta-sub" { span "Opening night 19:00" }

      line id="rule.v1" x1=(px)212 y1=(px)612 x2=(px)212 y2=(px)682 stroke=(token)"color.rule" stroke-width=(token)"stroke.thin"

      text id="col2.label" x=(px)228 y=(px)614 w=(px)164 h=(px)16 style="meta-label" { span "HOURS" }
      text id="col2.val" x=(px)228 y=(px)634 w=(px)164 h=(px)20 style="meta-value" { span "Thu — Sun" }
      text id="col2.sub" x=(px)228 y=(px)654 w=(px)164 h=(px)20 style="meta-sub" { span "19:00 to 23:00" }

      line id="rule.v2" x1=(px)404 y1=(px)612 x2=(px)404 y2=(px)682 stroke=(token)"color.rule" stroke-width=(token)"stroke.thin"

      text id="col3.label" x=(px)420 y=(px)614 w=(px)144 h=(px)16 style="meta-label" { span "LOCATION" }
      text id="col3.val" x=(px)420 y=(px)634 w=(px)144 h=(px)20 style="meta-value" { span "Botanical Hall" }
      text id="col3.sub" x=(px)420 y=(px)654 w=(px)144 h=(px)20 style="meta-sub" { span "Zurich · Free entry" }
    }
  }
}
