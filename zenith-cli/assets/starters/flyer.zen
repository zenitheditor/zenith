          text id="hero.kicker" style="ui.caption" font-weight=(token)"font.weight.heading" { span "COMMUNITY BIKE WORKSHOP" }
          text id="hero.title" style="ui.display" { span "Fix-It Sunday" }
          text id="hero.subtitle" { span "Bring your bike. Leave knowing how to keep it rolling." }
        }
        frame id="details" layout="column" {
          frame id="details.when" layout="row" align="center" gap=(token)"space.md" padding-y=(token)"space.sm" {
