            text id="details.when.value" w="fill" font-weight=(token)"font.weight.heading" { span "Sunday, June 7 · 10:00 – 16:00" }
          }
          rect id="details.rule.1" h=(token)"border.width" fill=(token)"color.base.300"
          frame id="details.where" layout="row" align="center" gap=(token)"space.md" padding-y=(token)"space.sm" {
            text id="details.where.label" w=(token)"layout.label" style="ui.caption" font-weight=(token)"font.weight.heading" { span "WHERE" }
            text id="details.where.value" w="fill" font-weight=(token)"font.weight.heading" { span "Spoke & Chain, 18 Canal Row" }
          }
          rect id="details.rule.2" h=(token)"border.width" fill=(token)"color.base.300"
          frame id="details.cost" layout="row" align="center" gap=(token)"space.md" padding-y=(token)"space.sm" {
            text id="details.cost.label" w=(token)"layout.label" style="ui.caption" font-weight=(token)"font.weight.heading" { span "COST" }
            text id="details.cost.value" w="fill" font-weight=(token)"font.weight.heading" { span "Free. Stands and tools provided." }
          }
        }
        frame id="topics" layout="column" gap=(token)"space.xs" {
          text id="topics.title" style="ui.caption" font-weight=(token)"font.weight.heading" { span "WHAT WE COVER" }
          text id="topics.1" bullet="•" { span "Flat tyres, tubes and patches" }
          text id="topics.2" bullet="•" { span "Brake and gear adjustment" }
          text id="topics.3" bullet="•" { span "Chain cleaning and everyday care" }
