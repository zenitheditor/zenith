# The editor page is embedded into the binary and the vendored bundle is
# checked against a byte size and sha256. A CRLF checkout on Windows would
# change both, so these files always check out with LF.
zenith-cli/assets/editor/** text eol=lf
zenith-cli/tests/editor_e2e/** text eol=lf
# The pinned render, perceive, and starter hashes are checked in canonical LF form. The
# example sources are the input of those hashes, so every target reads the
# same bytes.
zenith-cli/tests/render_hashes.json text eol=lf
zenith-cli/tests/perceive_hashes.json text eol=lf
zenith-cli/tests/starter_hashes.json text eol=lf
zenith-cli/assets/starters/** text eol=lf
examples/** text=auto eol=lf
